new file mode 100644
index 0000000..0864ad1
--- /dev/null
+++ b/store.go
@@ -0,0 +1,40 @@
+package main
+
+import (
+	"context"
+
+	"github.com/jackc/pgx/v5/pgxpool"
+)
+
+const schema = `
+CREATE TABLE IF NOT EXISTS events (
+	id         TEXT PRIMARY KEY,
+	type       TEXT NOT NULL,
+	created_at TIMESTAMPTZ NOT NULL,
+	payload    JSONB NOT NULL
+)`
+
+type PGStore struct{ pool *pgxpool.Pool }
+
+func NewPGStore(ctx context.Context, url string) (*PGStore, error) {
+	pool, err := pgxpool.New(ctx, url)
+	if err != nil {
+		return nil, err
+	}
+	if _, err := pool.Exec(ctx, schema); err != nil {
+		pool.Close()
+		return nil, err
+	}
+	return &PGStore{pool: pool}, nil
+}
+
+func (p *PGStore) Close() { p.pool.Close() }
+
+// Save is idempotent: redelivered event IDs are ignored.
+func (p *PGStore) Save(ctx context.Context, e Event) error {
+	_, err := p.pool.Exec(ctx,
+		`INSERT INTO events (id, type, created_at, payload) VALUES ($1, $2, $3, $4)
+		 ON CONFLICT (id) DO NOTHING`,
+		e.ID, e.Type, e.Created, e.Payload)
+	return err
+}
