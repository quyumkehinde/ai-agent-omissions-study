@@ -0,0 +1,44 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"log"
+	"net/http"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+)
+
+func main() {
+	secret := os.Getenv("MIRROR_WEBHOOK_SECRET")
+	dbURL := os.Getenv("MIRROR_DATABASE_URL")
+	if secret == "" || dbURL == "" {
+		log.Fatal("MIRROR_WEBHOOK_SECRET and MIRROR_DATABASE_URL must be set")
+	}
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+
+	store, err := NewPGStore(ctx, dbURL)
+	if err != nil {
+		log.Fatalf("database: %v", err)
+	}
+	defer store.Close()
+
+	srv := &http.Server{
+		Addr:              ":8080",
+		Handler:           (&Server{Secret: secret, Store: store, Now: time.Now}).Routes(),
+		ReadHeaderTimeout: 10 * time.Second,
+		ReadTimeout:       30 * time.Second,
+	}
+	go func() {
+		<-ctx.Done()
+		sctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		defer cancel()
+		srv.Shutdown(sctx)
+	}()
+	if err := srv.ListenAndServe(); !errors.Is(err, http.ErrServerClosed) {
+		log.Fatal(err)
+	}
+}
diff --git a/store.go b/store.go
new file mode 100644
index 0000000..722798d
--- /dev/null
+++ b/store.go
@@ -0,0 +1,40 @@
+package main
+
+import (
+	"context"
+
+	"github.com/jackc/pgx/v5/pgxpool"
+)
+
+const schema = `
+CREATE TABLE IF NOT EXISTS events (
+	id         TEXT PRIMARY KEY,
+	type       TEXT NOT NULL,
+	created_at TIMESTAMPTZ NOT NULL,
+	payload    JSONB NOT NULL
+)`
+
+type PGStore struct{ pool *pgxpool.Pool }
+
+func NewPGStore(ctx context.Context, url string) (*PGStore, error) {
+	pool, err := pgxpool.New(ctx, url)
+	if err != nil {
+		return nil, err
+	}
+	if _, err := pool.Exec(ctx, schema); err != nil {
+		pool.Close()
+		return nil, err
+	}
+	return &PGStore{pool: pool}, nil
+}
+
+func (p *PGStore) Close() { p.pool.Close() }
+
+// Save is idempotent: redelivered events are a no-op.
+func (p *PGStore) Save(ctx context.Context, e Event) error {
+	_, err := p.pool.Exec(ctx,
+		`INSERT INTO events (id, type, created_at, payload) VALUES ($1, $2, $3, $4)
+		 ON CONFLICT (id) DO NOTHING`,
+		e.ID, e.Type, e.Created, e.Payload)
+	return err
+}
